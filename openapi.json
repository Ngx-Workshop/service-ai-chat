  "info": {
    "title": "NGX service-ai-chat API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ChatCommandDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "subscribe",
              "send_message",
              "cancel_run"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "conversationId": {
            "type": "string"
          },
          "clientMessageId": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 8000
          },
          "runId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "requestId",
          "conversationId"
        ]
      },
      "ChatPartDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "tool",
              "a2ui"
            ]
          },
          "text": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "kind"
        ]
      },
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "clientMessageId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "streaming",
              "completed",
              "failed",
              "canceled"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatPartDto"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "status",
          "parts",
          "createdAt"
        ]
      },
      "ConversationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "revision": {
            "type": "number"
          },
          "activeRunId": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "updatedAt",
          "revision",
          "messages"
        ]
      },
      "ChatEventDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ready",
              "snapshot",
              "error"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "description": "Authenticated principal on ready events; permits clearing cached state after account changes."
          },
          "conversation": {
            "$ref": "#/components/schemas/ConversationDto"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "SocketAuthenticateDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "authenticate"
            ]
          },
          "ticket": {
            "type": "string",
            "description": "One-use ticket from POST /ai-chat/socket-ticket. Expires after 30 seconds."
          }
        },
        "required": [
          "type",
          "ticket"
        ]
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "default": "New conversation"
          }
        }
      },
      "SocketTicketDto": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "expiresAt"
        ]
      },
      "AuthTestDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "ExampleMongodbDocObjectDto": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          }
        },
        "required": [
          "street",
          "city",
          "state",
          "zip"
        ]
      },
      "CreateExampleMongodbDocDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "SOME_ENUM",
              "SOME_OTHER_ENUM"
            ]
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          },
          "exampleMongodbDocObject": {
            "$ref": "#/components/schemas/ExampleMongodbDocObjectDto"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "ExampleMongodbDocDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "SOME_ENUM",
              "SOME_OTHER_ENUM"
            ]
          },
          "version": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "archived": {
            "type": "boolean"
          },
          "exampleMongodbDocObject": {
            "$ref": "#/components/schemas/ExampleMongodbDocObjectDto"
          },
          "__v": {
            "type": "number"
          }
        },
        "required": [
          "_id",
          "name",
          "type",
          "version",
          "description",
          "lastUpdated",
          "archived",
          "__v"
        ]
      },
      "UpdateExampleMongodbDocDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "SOME_ENUM",
              "SOME_OTHER_ENUM"
            ]
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          },
          "exampleMongodbDocObject": {
            "$ref": "#/components/schemas/ExampleMongodbDocObjectDto"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}